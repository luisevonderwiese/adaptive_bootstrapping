import os
import sys
import pathlib


d = "../data_reworked/treebase/msa"
res_d = "../data_reworked/treebase/difficulty_labels"
msa_paths = [os.path.join(d, fn) for fn in os.listdir(d)]
msa_names = [str(os.path.split(pth)[1]).split(".")[0] for pth in msa_paths]
msa_names = [name for name in msa_names if name != ""]
msas = dict(zip(msa_names, msa_paths))

raxmlng_prefix = pathlib.Path(res_d) / "{msa}"/ "labelGen"

rule all:
    input:
        expand(raxmlng_prefix.with_suffix(".csv"), msa=msa_names),




rule bootstrapping:
    output:
        raxml_bootstraps = raxmlng_prefix.with_suffix(".csv"),
    params:
        prefix  = str(raxmlng_prefix),
        msa     = lambda wildcards: msas[wildcards.msa],
    log:
        raxml_log = raxmlng_prefix.with_suffix(".log")
    threads: 8
    resources:
        mem_mb = 4000,
        disk_mb = 4000,
        run_time = 480,
    shell:
    	"label "
    	"-m {params.msa} "
    	"-r /hits/fast/cme/haeusele/adaptive_bootstrapping/snakemake_new/bin/raxml-ng "
    	"-i /hits/fast/cme/haeusele/adaptive_bootstrapping/snakemake_new/bin/iqtree2 "
    	"-p {params.prefix} "
    	"--ntrees 100 "
    	"> {log.raxml_log} "





