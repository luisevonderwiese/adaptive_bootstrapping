import os
import sys
import pathlib



d = "../data/sim/msa"
res_d = "../data/sim/au"
msa_paths = [os.path.join(d, fn) for fn in os.listdir(d)]
msa_names = [str(os.path.split(pth)[1]).split(".")[0] for pth in msa_paths]
msa_names = [name for name in msa_names if name != ""]


raxmlng_prefix = pathlib.Path(res_d) / "{msa}"/ "consense_plausible"
plausible_trees = pathlib.Path(res_d) / "{msa}"/ "plausible.trees"


rule all:
    input:
        expand(raxmlng_prefix.with_suffix(".raxml.consensusTreeMR"), msa=msa_names),




rule bootstrapping:
    output:
        raxml_bootstraps = raxmlng_prefix.with_suffix(".raxml.consensusTreeMR"),
    params:
        prefix  = str(raxmlng_prefix),
        plausible_trees = str(plausible_trees),
    log:
        raxml_log = raxmlng_prefix.with_suffix(".raxml.consense_plausible.log")
    threads: 8
    resources:
        mem_mb = 4000,
        disk_mb = 4000,
        run_time = 480,
    shell:
        "./raxml-ng-2 --consense MR "
        "--tree {params.plausible_trees} "
        "--prefix {params.prefix} "
        "--seed 2 "
        "--threads 8 "
        "--force model_lh_impr "
        #"--force perf_threads "
        "> {log.raxml_log} "








