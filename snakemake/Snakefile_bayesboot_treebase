import os
import sys
import pathlib



d = "../data/treebase/msa"
res_d = "../data/treebase/bayesboot"
msa_paths = [os.path.join(d, fn) for fn in os.listdir(d)]
msa_names = [str(os.path.split(pth)[1]).split(".")[0] for pth in msa_paths]
msa_names = [name for name in msa_names if name != ""]
msas = dict(zip(msa_names, msa_paths))

raxmlng_prefix = pathlib.Path(res_d) / "{msa}" / "{msa}.phy" 
temp_prefix = pathlib.Path(d) / "{msa}.phy_phyml"
prefix_dir = pathlib.Path(res_d) / "{msa}"


rule all:
    input:
        expand(str(raxmlng_prefix) + "_phyml_tree.txt", msa=msa_names),




rule bootstrapping:
    output:
        raxml_bootstraps = str(raxmlng_prefix) + "_phyml_tree.txt",
    params:
        msa     = lambda wildcards: msas[wildcards.msa],
        prefix  = str(raxmlng_prefix),
        temp_prefix = str(temp_prefix),
        prefix_dir = str(prefix_dir)

    log:
        raxml_log = str(raxmlng_prefix) + "_phyml.log"
    threads: 8
    resources:
        mem_mb = 4000,
        disk_mb = 4000,
        run_time = 480,
    shell:
        "./phyml "
        "-n 1 "
        "-i {params.msa} "
        "--model GTR "
        "-f o "
        "--pars "
        "--search BEST "
        "-b 100 "
        "--bayesian_bootstrap "
        "> {log.raxml_log} "
        "&& mv {params.temp_prefix}* {params.prefix_dir} "








