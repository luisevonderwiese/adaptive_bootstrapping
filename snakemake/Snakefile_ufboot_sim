import os
import sys
import pathlib

d = "../data/sim/msa"
res_d = "../data/sim/ufboot"
msa_paths = [os.path.join(d, fn) for fn in os.listdir(d)]
msa_names = [str(os.path.split(pth)[1]).split(".")[0] for pth in msa_paths]
msa_names = [name for name in msa_names if name != ""]
msa_paths = [os.path.join(msa_path, "gtr_g_sim_msa.fasta") for msa_path in msa_paths]
msas = dict(zip(msa_names, msa_paths))

raxmlng_prefix = pathlib.Path(res_d) / "{msa}"/ "ufboot"
best_tree = pathlib.Path(res_d) / "{msa}"/ "ufboot.treefile"
splits = pathlib.Path(res_d) / "{msa}"/ "ufboot.splits.nex"


rule all:
    input:
        expand(raxmlng_prefix.with_suffix(".splits.nex.suptree"), msa=msa_names),




rule bootstrapping:
    output:
        raxml_bootstraps = raxmlng_prefix.with_suffix(".splits.nex.suptree"),
    params:
        prefix  = str(raxmlng_prefix),
        best_tree = str(best_tree),
        splits = str(splits),
        msa     = lambda wildcards: msas[wildcards.msa],
    log:
        raxml_log = raxmlng_prefix.with_suffix(".iqtree.log")
    threads: 8
    resources:
        mem_mb = 4000,
        disk_mb = 4000,
        run_time = 480,
    shell:
        "./iqtree2 "
        "-s {params.msa} "
        "-m GTR+G+FO "
        "-B 1000 "
        "-T 8 "
        "--prefix {params.prefix} "
        "> {log.raxml_log} "
        "&& ./iqtree2 "
        "-sup {params.best_tree} {params.splits} "








