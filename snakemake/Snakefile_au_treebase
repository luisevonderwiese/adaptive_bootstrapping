import os
import sys
import pathlib



d = "../data/treebase/msa"
res_d = "../data/treebase/au"
ml_d = "../data/treebase/ml_trees"
msa_paths = [os.path.join(d, fn) for fn in os.listdir(d)]
msa_names = [str(os.path.split(pth)[1]).split(".")[0] for pth in msa_paths]
msa_names = [name for name in msa_names if name != ""]
msas = dict(zip(msa_names, msa_paths))

raxmlng_prefix = pathlib.Path(res_d) / "{msa}"/ "au"
ml_trees = pathlib.Path(ml_d) / "{msa}.mlTrees"


rule all:
    input:
        expand(raxmlng_prefix.with_suffix(".raxml.treeTests"), msa=msa_names),




rule bootstrapping:
    output:
        raxml_bootstraps = raxmlng_prefix.with_suffix(".raxml.treeTests"),
    params:
        prefix  = str(raxmlng_prefix),
        ml_trees = str(ml_trees),
        msa     = lambda wildcards: msas[wildcards.msa],
    log:
        raxml_log = raxmlng_prefix.with_suffix(".raxml.au.log")
    threads: 8
    resources:
        mem_mb = 4000,
        disk_mb = 4000,
        run_time = 480,
    shell:
        "./raxml-ng-au --au-test "
        "--msa {params.msa} "
        "--model GTR+G "
        "--tree {params.ml_trees} "
        "--prefix {params.prefix} "
        "--seed 2 "
        "--threads 8 "
        "--extra seq-allgap-remove "
        "--force model_lh_impr "
        #"--force perf_threads "
        "> {log.raxml_log} "








