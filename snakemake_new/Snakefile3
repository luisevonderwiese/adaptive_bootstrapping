    for msa_name in msa_names:
        pred_row = diff_pred[diff_pred["dataset"] == msa_name]
        if len(pred_row) == 0:
            continue
        diff = pred_row["difficulty_prediction"].iloc[0]
        if diff < 0.6:
            continue
        stats_path = os.path.join(basedir, cat, "selection_stats", msa_name + ".csv")
        best_tree_path = os.path.join(basedir, cat, "raxml", msa_name, "default_inference.raxml.bestTree")
        if not os.path.isfile(stats_path) or not os.path.isfile(best_tree_path):
            continue
        msa_stats = pd.read_csv(stats_path).iloc[0]
        if msa_stats["max_brlen"] < 1 and msa_stats["r_z"] < 0.5:
            new_names.append(msa_name)
