import os
import sys
import pathlib
import pandas as pd

basedir = "/hits/fast/cme/haeusele/adaptive_bootstrapping/difficult_data"
cats = ["evonaps_difficult", "alisim2"]
msas = {}
all_msa_names = {}
all_true_trees = {}

for cat in cats:
    msa_dir = os.path.join(basedir, cat, "msa")
    msa_paths = [os.path.join(msa_dir, fn) for fn in os.listdir(msa_dir)]
    msa_names = [fn.split(".")[0] for fn in os.listdir(msa_dir)]
    msa_names = [name for name in msa_names if name != ""]
    msas[cat] = dict(zip(msa_names, msa_paths))
    all_msa_names[cat] = msa_names
    if cat == "alisim2":
        true_tree_paths = [os.path.join(basedir, cat, "simtrees", fn.split(".")[0] + ".tree") for fn in os.listdir(msa_dir)]
    else:
        true_tree_paths = ["" for fn in os.listdir(msa_dir)]
    all_true_trees[cat] = dict(zip(msa_names, true_tree_paths))

msa_nodup_path = os.path.join(basedir, "{cat}", "msa_nodup", "{msa}.phy")
raxmlng_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "default_inference")
selection_stats_path = os.path.join(basedir, "{cat}", "selection_stats", "{msa}.csv")
true_tree_nodup_path = os.path.join(basedir, "{cat}", "true_trees_nodup", "{msa}.tree")
true_tree_collapsed_path = os.path.join(basedir, "{cat}", "true_trees_collapsed", "{msa}.tree")

rule all:
    input:
        expand(selection_stats_path, cat = ["evonaps_difficult"], msa=all_msa_names["evonaps_difficult"]) + \
        expand(selection_stats_path, cat = ["alisim2"], msa=all_msa_names["alisim2"]),
        expand(true_tree_collapsed_path, cat = ["alisim2"], msa=all_msa_names["alisim2"]),

include: "rules/remove_duplicates.smk"
include: "rules/remove_duplicates_from_true_tree.smk"
include: "rules/collapse_true_tree.smk"
include: "rules/default_inference.smk"
include: "rules/selection_stats.smk"










