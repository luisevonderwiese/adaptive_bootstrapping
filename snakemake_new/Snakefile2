import os
import sys
import pathlib
import pandas as pd

basedir = "/hits/fast/cme/haeusele/adaptive_bootstrapping/test_data"
cats = ["treebase", "sim"]
msas = {}
all_msa_names = {}
for cat in ["treebase", "sim"]:
    msa_dir = os.path.join(basedir, cat, "msa")
    msa_paths = [os.path.join(msa_dir, fn, "msa.fasta") for fn in os.listdir(msa_dir)]
    msa_names = [fn.split(".")[0] for fn in os.listdir(msa_dir)]
    msa_names = [name for name in msa_names if name != ""]
    msas[cat] = dict(zip(msa_names, msa_paths))
    all_msa_names[cat] = msa_names

msa_nodup_path = os.path.join(basedir, "{cat}", "msa_nodup", "{msa}.phy")
raxmlng_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "default_inference")
selection_stats_path = os.path.join(basedir, "{cat}", "selection_stats", "{msa}.csv")

new_all_msa_names = {}
for cat, msa_names in all_msa_names.items():
    new_names = []
    for msa_name in msa_names:
        msa_stats = pd.read_csv(os.path.join(basedir, cat, "selection_stats", msa_name + ".csv")).iloc[0]
        if msa_stats["max_brlen"] < 1 and msa_stats["r_z"] < 0.5:
            new_names.append(msa_name)
    new_all_msa_names[cat] = msa_name

bootstrapping_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "bootstrapping")
best_support_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "support_best")
shalrt_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "shalrt")
search80_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "search80")
search100_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "search100")
au_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "au")
consensus_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "plausible_consensus")
consensus_support_prefix = os.path.join(basedir, "{cat}", "raxml", "{msa}", "consensus_support")
label_prefix = os.path.join(basedir, "{cat}", "difficulty_labels", "{msa}", "difficulty_label")
collapsed_label_prefix = os.path.join(basedir, "{cat}", "difficulty_labels", "{msa}", "difficulty_label_collapsed")

